rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to verify user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate Task data schema
    function isValidTask(task) {
      return task.title is string 
        && task.title.size() > 0 
        && task.title.size() <= 300
        && task.isCompleted is bool
        && task.dateKey is string
        && task.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (task.priority == null || task.priority in ['low', 'medium', 'high'])
        && (task.description == null || task.description is string)
        && (task.dueTime == null || task.dueTime is string);
    }

    // User document path
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) 
        && (request.resource.data.keys().hasAll(['email']) || request.resource.data.email is string);
      allow delete: if isOwner(userId);

      // Tasks subcollection path: users/{userId}/tasks/{taskId}
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidTask(request.resource.data)
          && request.resource.data.userId == userId;

        allow update: if isOwner(userId)
          && isValidTask(request.resource.data)
          && request.resource.data.userId == userId;

        allow delete: if isOwner(userId);
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
